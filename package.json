{
  "name": "court-auction-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "Read-only MCP server for South Korea Supreme Court real-estate auction data",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "mcp:stdio": "tsx src/index.ts",
    "mcp:http": "tsx src/index.ts --http",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "smoke:mcp": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "court-auction-notice-search": "0.3.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2"
  }
}
