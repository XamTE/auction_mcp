{
  "name": "court-auction-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Read-only MCP server for South Korea Supreme Court real-estate auction data",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "start:http": "tsx src/index.ts --http",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "check": "npm run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "court-auction-notice-search": "0.3.3",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
